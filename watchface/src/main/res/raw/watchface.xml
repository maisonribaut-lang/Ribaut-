<?xml version="1.0" encoding="utf-8"?>
<WatchFace width="450" height="450">
    <Scene backgroundColor="#08090C">
        <PartText x="0" y="48" width="450" height="55">
            <Text align="CENTER">
                <Font family="SYNC_TO_DEVICE" size="28" color="#FFFFFF">RIBAUT</Font>
            </Text>
        </PartText>

        <PartText x="0" y="112" width="450" height="72">
            <Text align="CENTER">
                <Font family="SYNC_TO_DEVICE" size="52" color="#FFFFFF">
                    <Template><![CDATA[%02d:%02d]]><Parameter expression="[HOUR_0_23]"/><Parameter expression="[MINUTE]"/></Template>
                </Font>
            </Text>
        </PartText>

        <PartText x="0" y="185" width="450" height="38">
            <Text align="CENTER">
                <Font family="SYNC_TO_DEVICE" size="21" color="#D9D9D9">
                    <Template><![CDATA[%02d/%02d]]><Parameter expression="[DAY]"/><Parameter expression="[MONTH]"/></Template>
                </Font>
            </Text>
        </PartText>

        <PartText x="0" y="330" width="450" height="42">
            <Text align="CENTER">
                <Font family="SYNC_TO_DEVICE" size="20" color="#D9D9D9">
                    <Template><![CDATA[BAT %d%%]]><Parameter expression="[BATTERY_PERCENT]"/></Template>
                </Font>
            </Text>
        </PartText>

        <PartDraw x="0" y="0" width="450" height="450">
            <Group name="analog_hands">
                <PartImage x="211" y="104" width="28" height="242" pivotX="0.5" pivotY="0.5" angle="[HOUR_0_11] * 30 + [MINUTE] * 0.5">
                    <Image resource="hour_hand" />
                </PartImage>
                <PartImage x="211" y="74" width="28" height="302" pivotX="0.5" pivotY="0.5" angle="[MINUTE] * 6 + [SECOND] * 0.1">
                    <Image resource="minute_hand" />
                </PartImage>
                <PartImage x="217" y="65" width="16" height="320" pivotX="0.5" pivotY="0.5" angle="[SECOND] * 6">
                    <Image resource="second_hand" />
                </PartImage>
            </Group>
        </PartDraw>

        <PartText x="0" y="382" width="450" height="35">
            <Text align="CENTER">
                <Font family="SYNC_TO_DEVICE" size="14" color="#8A8A8A">RIBAUT WATCH DESIGNER</Font>
            </Text>
        </PartText>
    </Scene>
</WatchFace>
